{
  "manifest_version": 3,
  "name": "Panda Dock",
  "description": "Panda Dock：现代、高效的 Chrome 开发者日常工具箱，内置智能解析、网页存储、Base64、JSON、网址、时间戳与二维码等常用工具。",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Panda Dock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle-toolkit": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "打开/收起工具箱"
    },
    "toggle-detect": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "快速唤起智能解析"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ball*.png", "icons/*.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": ["storage", "sidePanel", "contextMenus", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
