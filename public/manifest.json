{
  "manifest_version": 3,
  "name": "Panda Dock",
  "description": "Panda Dock：基于 React + Vite 的 Chrome 开发者工具箱（Popup / Options / 侧边栏 / Content Script 悬浮球与抽屉）",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Panda Dock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "打开侧边栏工具箱"
    },
    "open-drawer": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "打开或收起网页内工具箱抽屉"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ball*.png", "icons/*.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": ["storage", "sidePanel", "contextMenus", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
