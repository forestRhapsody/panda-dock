{
  "name": "panda-dock",
  "private": true,
  "version": "0.2.0",
  "description": "Panda Dock：现代、高效的 Chrome 开发者日常工具箱，内置智能解析、网页存储、Base64、JSON、网址、时间戳与二维码等常用工具。",
  "license": "MIT",
  "author": "forest rhapsody",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forestRhapsody/dev-box.git"
  },
  "homepage": "https://github.com/forestRhapsody/dev-box#readme",
  "bugs": {
    "url": "https://github.com/forestRhapsody/dev-box/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "developer-tools",
    "toolbox",
    "react",
    "typescript",
    "vite",
    "base64",
    "json",
    "jwt",
    "qrcode",
    "i18n"
  ],
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "tsc -b && vite build --config vite.content.config.ts --logLevel warn && vite build --config vite.background.config.ts --logLevel warn && vite build --logLevel warn",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --write src/ --log-level warn",
    "gate": "pnpm format && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run --reporter=dot",
    "test:changed": "vitest run --changed --reporter=dot",
    "test:watch": "vitest",
    "type-check": "tsc -b"
  },
  "dependencies": {
    "i18next": "^26.4.1",
    "jsonc-parser": "^3.3.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.33.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/chrome": "^0.2.8",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-checker": "^0.10.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.0"
  },
  "volta": {
    "node": "24.8.0"
  }
}
